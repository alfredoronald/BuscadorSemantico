        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://schema.org/discount"/>
        <rdfs:comment>Indica si el atractivo ofrece descuentos.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Atractivo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Atractivo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/type"/>
        <rdfs:comment>Tipo o categoría del atractivo turístico.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Ecosistema -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Ecosistema">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Natural"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/ecosystem"/>
        <rdfs:comment>Tipo de ecosistema del atractivo natural.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Establecimiento -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Establecimiento">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Establecimiento_Gastronomico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/type"/>
        <rdfs:comment>Tipo de establecimiento gastronómico.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Evento -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Evento">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Evento_Turístico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/eventType"/>
        <rdfs:comment>Tipo de evento turístico.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Hospedaje -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Hospedaje">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Hospedaje"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/hotelType"/>
        <rdfs:comment>Tipo de hospedaje.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Patrimonio -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Patrimonio">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Cultural_Histórico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/heritageType"/>
        <rdfs:comment>Tipo de patrimonio cultural.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Producto -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Producto">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Producto_Alimenticio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/foodType"/>
        <rdfs:comment>Tipo de producto alimenticio.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Recreacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Recreacion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Recreativo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/leisure"/>
        <rdfs:comment>Tipo de recreación que ofrece el atractivo.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Transporte -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tipo_Transporte">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Transporte"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/transportType"/>
        <rdfs:comment>Tipo de medio de transporte.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Ubicacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Ubicacion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Entidad_Turistica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <owl:equivalentProperty rdf:resource="http://dbpedia.org/ontology/location"/>
        <rdfs:comment>Ubicación geográfica de la entidad turística.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes - ENRIQUECIDAS CON owl:equivalentClass Y CONEXIONES A DBPEDIA
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Arqueológico -->

    <owl:Class rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Arqueológico">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico"/>
        <!-- CONEXIONES AÑADIDAS A DBPEDIA -->
        <owl:equivalentClass rdf:resource="http://dbpedia.org/ontology/ArchaeologicalSite"/>
        <owl:equivalentClass rdf:resource="http://dbpedia.org/ontology/HistoricPlace"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Archaeological_site"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Archaeological_site"/>
        <rdfs:comment>Lugar que contiene evidencia de actividad humana pasada. Equivalente a dbo:ArchaeologicalSite.</rdfs:comment>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Cultural_Histórico"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Natural"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Recreativo"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Cultural_Histórico -->

    <owl:Class rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Cultural_Histórico">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico"/>
        <!-- CONEXIONES AÑADIDAS A DBPEDIA -->
        <owl:equivalentClass rdf:resource="http://dbpedia.org/ontology/CulturalHeritage"/>
        <owl:equivalentClass rdf:resource="http://dbpedia.org/ontology/HistoricPlace"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Cultural_heritage"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Cultural_heritage"/>
        <rdfs:comment>Lugares con valor cultural, histórico o patrimonial. Equivalente a dbo:CulturalHeritage.</rdfs:comment>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Natural"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Recreativo"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Natural -->

    <owl:Class rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Natural">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico"/>
        <!-- CONEXIONES AÑADIDAS A DBPEDIA -->
        <owl:equivalentClass rdf:resource="http://dbpedia.org/ontology/NaturalPlace"/>
        <owl:equivalentClass rdf:resource="http://dbpedia.org/ontology/ProtectedArea"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Natural_landmark"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Natural_landmark"/>
        <rdfs:comment>Espacios geográficos con valor paisajístico o ecológico. Equivalente a dbo:NaturalPlace.</rdfs:comment>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Recreativo"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Recreativo -->

    <owl:Class rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Recreativo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico"/>
        <!-- CONEXIONES AÑADIDAS A DBPEDIA -->
        <owl:equivalentClass rdf:resource="http://dbpedia.org/ontology/AmusementPark"/>
        <owl:equivalentClass rdf:resource="http://dbpedia.org/ontology/SportsFacility"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Recreation"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Recreation"/>
        <rdfs:comment>Espacios diseñados para el entretenimiento y ocio. Equivalente a dbo:AmusementPark.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico -->

    <owl:Class rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Entidad_Turistica"/>
        <!-- CONEXIONES AÑADIDAS A DBPEDIA -->
        <owl:equivalentClass rdf:resource="http://dbpedia.org/ontology/TouristAttraction"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Tourist_attraction"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Tourist_attraction"/>
        <rdfs:comment>Lugar de interés que los turistas visitan. Equivalente a dbo:TouristAttraction.</rdfs:comment>
