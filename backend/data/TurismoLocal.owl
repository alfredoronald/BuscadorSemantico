        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://schema.org/openingHours"/>
        <rdfs:comment>Hora de cierre de la entidad turística.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Horario_Especial -->

