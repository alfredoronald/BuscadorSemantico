<?xml version="1.0"?>
<!-- NAMESPACES AÑADIDOS PARA CONEXIÓN CON DBPEDIA Y WIKIPEDIA -->
<rdf:RDF xmlns="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#"
     xml:base="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dbo="http://dbpedia.org/ontology/"
     xmlns:dbp="http://dbpedia.org/property/"
     xmlns:dbr="http://dbpedia.org/resource/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:geo="http://www.w3.org/2003/01/geo/wgs84_pos#"
     xmlns:dct="http://purl.org/dc/terms/">
     
    <owl:Ontology rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba">
        <!-- ANOTACIONES AÑADIDAS PARA CONEXIÓN CON DBPEDIA -->
        <owl:imports rdf:resource="http://dbpedia.org/ontology/"/>
        <rdfs:comment>Ontología de Turismo de Cochabamba - Enriquecida con conexiones a DBpedia y Wikipedia</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://es.wikipedia.org/wiki/Cochabamba"/>
        <rdfs:seeAlso rdf:resource="https://www.dbpedia.org/page/Cochabamba"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#string -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#string">
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/xmlschema11-2/#string"/>
    </rdfs:Datatype>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties - ENRIQUECIDAS
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#estaCercaDe -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#estaCercaDe">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Entidad_Turistica"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Entidad_Turistica"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <owl:equivalentProperty rdf:resource="http://dbpedia.org/ontology/nearby"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/2000/01/rdf-schema#seeAlso"/>
        <rdfs:comment>Propiedad que indica que una entidad turística está cerca de otra. Equivalente a dbo:nearby.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#ofreceEvento -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#ofreceEvento">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Entidad_Turistica"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Evento_Turístico"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/event"/>
        <rdfs:comment>Una entidad turística ofrece un evento turístico. Relacionada con dbo:event.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#ofreceGastronomia -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#ofreceGastronomia">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Establecimiento_Gastronomico"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Producto_Alimenticio"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/cuisine"/>
        <rdfs:comment>Un establecimiento gastronómico ofrece un producto alimenticio. Relacionada con dbo:cuisine.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#ofreceHospedaje -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#ofreceHospedaje">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Servicio_Turistico"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Hospedaje"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/accommodation"/>
        <rdfs:comment>Un servicio turístico ofrece hospedaje. Relacionada con dbo:accommodation.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#seLlegaPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#seLlegaPor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Transporte"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/transportation"/>
        <rdfs:comment>A un atractivo turístico se llega por un medio de transporte.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#seRealizaEn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#seRealizaEn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Evento_Turístico"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/location"/>
        <rdfs:comment>Un evento turístico se realiza en un atractivo turístico. Relacionada con dbo:location.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#tieneAtractivo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#tieneAtractivo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Entidad_Turistica"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/touristAttraction"/>
        <rdfs:comment>Una entidad turística tiene un atractivo turístico.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#tieneEstablecimiento -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#tieneEstablecimiento">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Establecimiento_Gastronomico"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/restaurant"/>
        <rdfs:comment>Un atractivo turístico tiene un establecimiento gastronómico.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#ubicadoEn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#ubicadoEn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Entidad_Turistica"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Entidad_Turistica"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <owl:equivalentProperty rdf:resource="http://dbpedia.org/ontology/location"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/2003/01/geo/wgs84_pos#location"/>
        <rdfs:comment>Una entidad turística está ubicada en otra. Equivalente a dbo:location.</rdfs:comment>
    </owl:ObjectProperty>


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties - ENRIQUECIDAS CON CONEXIONES A DBPEDIA
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Accesibilidad -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Accesibilidad">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/accessibility"/>
        <rdfs:comment>Indica si un atractivo turístico es accesible para personas con discapacidad.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Actividades -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Actividades">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Natural"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/activity"/>
        <rdfs:comment>Actividades que se pueden realizar en un atractivo natural.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Capacidad -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Capacidad">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Transporte"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/capacity"/>
        <rdfs:comment>Capacidad de pasajeros o carga de un medio de transporte.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Costo_Aproximado -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Costo_Aproximado">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Transporte"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/cost"/>
        <rdfs:comment>Costo aproximado del transporte en bolivianos.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Costo_Entrada -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Costo_Entrada">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/admissionFee"/>
        <rdfs:comment>Costo de entrada al atractivo turístico en bolivianos.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Cultura_Origen -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Cultura_Origen">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Arqueológico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/culture"/>
        <rdfs:comment>Cultura o civilización de origen del atractivo arqueológico.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Descripcion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Descripcion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Entidad_Turistica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <owl:equivalentProperty rdf:resource="http://dbpedia.org/ontology/abstract"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <rdfs:comment>Descripción general de la entidad turística. Equivalente a dbo:abstract.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Disponible -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Disponible">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Hospedaje"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://schema.org/availability"/>
        <rdfs:comment>Indica si el hospedaje está disponible.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Epoca -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Epoca">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Cultural_Histórico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/era"/>
        <rdfs:comment>Época o período histórico del atractivo cultural.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Es_Tipico -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Es_Tipico">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Producto_Alimenticio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/regionalCuisine"/>
        <rdfs:comment>Indica si el producto alimenticio es típico de la región.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Estado_Conservacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Estado_Conservacion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Arqueológico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/conservationStatus"/>
        <rdfs:comment>Estado de conservación del atractivo arqueológico.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Fecha_Fin -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Fecha_Fin">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Evento_Turístico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <owl:equivalentProperty rdf:resource="http://dbpedia.org/ontology/endDate"/>
        <rdfs:comment>Fecha de finalización del evento turístico.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Fecha_Inicio -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Fecha_Inicio">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Evento_Turístico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <owl:equivalentProperty rdf:resource="http://dbpedia.org/ontology/startDate"/>
        <rdfs:comment>Fecha de inicio del evento turístico.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Frecuencia -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Frecuencia">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Evento_Turístico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/frequency"/>
        <rdfs:comment>Frecuencia con la que se realiza el evento (anual, mensual, diario, etc.).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Grado_Dificultad -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Grado_Dificultad">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Natural"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/ontology/difficulty"/>
        <rdfs:comment>Grado de dificultad para visitar el atractivo natural (1 a 5).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Gratuito -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Gratuito">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Atractivo_Turistico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://schema.org/isAccessibleForFree"/>
        <rdfs:comment>Indica si el acceso al atractivo es gratuito.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Horario_Apertura -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Horario_Apertura">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Entidad_Turistica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://schema.org/openingHours"/>
        <rdfs:comment>Hora de apertura de la entidad turística.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Horario_Atencion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Horario_Atencion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Servicio_Turistico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <!-- CONEXIÓN AÑADIDA A DBPEDIA -->
        <rdfs:seeAlso rdf:resource="http://schema.org/openingHours"/>
        <rdfs:comment>Horario de atención del servicio turístico.</rdfs:comment>
    </owl:DatatypeProperty>
    


