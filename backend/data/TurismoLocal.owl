    <!-- http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tiene_Descuento -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sarzuri/ontologies/2026/2/turismo-cochabamba#Tiene_Descuento">
